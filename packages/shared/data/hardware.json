      "name": "External thermal pump module, loop A",
      "short": "Pump module",
      "system": "thermal",
      "node": "Payload_PM",
      "location": "S1 truss, external",
      "description": "Circulates ammonia through the external radiators. A failing pump cuts cooling to half the station's electronics.",
      "readings": [
        { "id": "outletPressure", "label": "Pump outlet pressure", "unit": "kPa", "value": 301, "decimals": 0,
          "limits": { "nominal": [330, 390], "caution": [310, 410], "warning": [280, 430] },
          "drift": -0.22, "noise": 1.2, "floor": 262, "ceiling": 400 },
        { "id": "ammoniaFlow", "label": "Ammonia flow", "unit": "kg/h", "value": 2510, "decimals": 0,
          "limits": { "nominal": [2700, 3100], "caution": [2550, 3250], "warning": [2300, 3400] },
          "drift": -1.4, "noise": 12, "floor": 2200, "ceiling": 3000 },
        { "id": "motorCurrent", "label": "Pump motor current", "unit": "A", "value": 2.84, "decimals": 2,
          "limits": { "nominal": [1.9, 2.6], "caution": [1.8, 2.75], "warning": [1.6, 3.0] },
          "drift": 0.002, "noise": 0.02, "floor": 2.0, "ceiling": 3.2 }
      ],
      "task": {
        "type": "EVA",
        "title": "Replace the pump module (spacewalk)",
        "durationHours": 6.5,
        "load": 5,
        "skills": { "eva": 3, "thermal": 2, "mechanical": 2 },
        "steps": [
          "Power down loop A and vent ammonia lines through the quick-disconnects.",
          "Two crew exit through the Quest airlock; one more crew member supports from inside.",
          "Unbolt the failed module, install the spare from external stowage, reconnect the fluid lines.",
          "Repressurize loop A and verify flow and pressure from inside."
        ]
      }
    },
