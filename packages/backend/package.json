{
  "name": "@orbital/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Orbital Health Console API: health engine, station simulator, event store, real-time stream and the offline AI assistant.",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "cross-env NODE_ENV=production tsx src/server.ts",
    "reset": "tsx scripts/reset.ts",
    "data:labs": "tsx scripts/build-labs.ts",
    "ai:status": "tsx -e \"import('./src/ai/config.ts').then(async m=>{m.loadEnvFile();console.log(await m.resolveAiConfig())})\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@orbital/shared": "1.0.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
