# ---------------------------------------------------------------
# AI agent configuration for Orbital Health Console
# Copy this file to packages/backend/.env ONLY if you want to change something.
# Without a .env file the console detects the local Ollama model automatically.
# ---------------------------------------------------------------

# --- RECOMMENDED: a LOCAL model, no internet (as on board) ---
# 1. Install Ollama: https://ollama.com/download
# 2. In a terminal: ollama pull qwen2.5:3b     (about 2 GB; for better answers: qwen2.5:7b, about 4.7 GB)
# 3. Start the console: npm run dev  → the agent is detected automatically
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://localhost:11434

# --- OPTIONAL, for tests on Earth only (needs internet) ---
# Used only if Ollama is not running, or if AI_PROVIDER selects them explicitly.
# GEMINI_API_KEY=            # free: https://aistudio.google.com/apikey
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=

# Explicit choice of provider and model
# AI_PROVIDER=ollama         # ollama | gemini | openai | anthropic | none
# AI_MODEL=

# Demo settings
# HR_STALE_SECONDS=20
# SIM_INTERVAL_SECONDS=3
# ALERT_RECHECK_SECONDS=180   # after Acknowledge, check again after this delay; still critical → the alert is raised again
